# Hosted answer-model keys (all optional). The local MLX model and the keyless
# Pollinations fallback still work without any of these, so Lyra always answers.
# Paste a key to prefer that provider for stronger, faster answers.

# OpenAI — get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # uncomment for any OpenAI-compatible endpoint

# Anthropic — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional TTS (unused today — replies use the macOS `say` voice)
ELEVENLABS_API_KEY=

# Optional knobs
WHISPER_MODEL=small
SPEAKER_THRESHOLD=0.35
