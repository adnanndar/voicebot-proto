# OpenAI-compatible answer-model key (optional). Lyra still answers without it
# via the local MLX model and the keyless Pollinations fallback.

# --- OpenAI — https://platform.openai.com/api-keys --------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1   # uncomment to override

# --- or a FREE Groq key — https://console.groq.com/keys (OpenAI-compatible) --
# Set these three instead of the OpenAI lines above:
#   OPENAI_API_KEY=gsk_...
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=openai/gpt-oss-120b       # or openai/gpt-oss-20b / qwen/qwen3.8-27b
#   OPENAI_ASR_MODEL=whisper-large-v3-turbo  # speech-to-text (Groq transcription)

# Anthropic — get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Speaker recognition: Picovoice Eagle (free, on-device, no torch).
# Set a key to use Eagle instead of ECAPA. Get one at https://console.picovoice.ai
PICOVOICE_ACCESS_KEY=
EAGLE_THRESHOLD=0.4

# Alternative hosted speaker verification (Detectif.ai).
# Add a Detectif API key for REST use, or enable the no-key trial
# (10 checks/network; voice profiles expire after 24h).
DETECTIF_API_KEY=
DETECTIF_USE_TRIAL=false

# Optional TTS (unused today — replies use edge-tts)
ELEVENLABS_API_KEY=

# Optional knobs
WHISPER_MODEL=small
SPEAKER_THRESHOLD=0.35
